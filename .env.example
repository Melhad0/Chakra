# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR & BANCO DE DADOS (CHAKRA CLICKER)
# ==============================================================================

# String de conexão do Neon PostgreSQL (Serverless Free Tier)
# Crie seu banco gratuito em segundos em: https://neon.tech
# Exemplo: postgresql://neondb_owner:npg_xxxx@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Porta do servidor (no Render / Nuvem isso é injetado automaticamente pelo host)
PORT=5000

# Ativação do modo de depuração (False em produção)
FLASK_DEBUG=false

# URL do Frontend autorizada para CORS (opcional, por padrão aceita todas)
# Exemplo: https://chakra-clicker.vercel.app
FRONTEND_URL=*
